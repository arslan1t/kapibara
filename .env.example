# ═══════════════════════════════════════════════════════════════════════════════
# Капибара — environment variables
#
# Copy to .env and fill in. Never commit .env; never paste a real secret here.
# Variables are grouped by whether the application can run without them.
#
# Deployment instructions: README §5.
# ═══════════════════════════════════════════════════════════════════════════════


# ───────────────────────────────────────────────────────────────────────────────
# REQUIRED — the application will not serve customers without these
# ───────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Pooled connection used by the application at runtime.
# Supabase: Project Settings → Database → Connection string → "Transaction".
# Append ?pgbouncer=true when the URL points at a transaction-mode pooler,
# otherwise Prisma's prepared statements collide across requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"

# Direct (unpooled) connection, used ONLY by `prisma migrate`.
# Migrations take advisory locks, which a transaction pooler breaks.
# Supabase: the same page → "Session" connection string (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Authentication ────────────────────────────────────────────────────────────
# Signs session cookies. Generate with:  openssl rand -base64 32
# Changing it signs every user out.
AUTH_SECRET=

# The application's public origin. Must be the real HTTPS URL in production —
# Auth.js validates callbacks against it.
AUTH_URL="https://example.com"

# Used by metadata, robots.txt, sitemap.xml and links inside emails.
# This is the one variable deliberately exposed to the browser.
NEXT_PUBLIC_SITE_URL="https://example.com"

# ── Object storage ────────────────────────────────────────────────────────────
# "supabase" | "s3" | "local". Local storage is refused in production: files
# would be lost on the next deploy. Fill in exactly one provider block below.
STORAGE_DRIVER="supabase"


# ───────────────────────────────────────────────────────────────────────────────
# STORAGE PROVIDER — fill in the block matching STORAGE_DRIVER
# ───────────────────────────────────────────────────────────────────────────────

# ── Option A: Supabase Storage ────────────────────────────────────────────────
# The private bucket MUST have "Public bucket" switched off in the dashboard.
SUPABASE_URL="https://PROJECT.supabase.co"
#
# The SERVICE-ROLE key — not the publishable one. They sit next to each other
# in the Supabase dashboard and are easy to mix up, but only service-role can
# write to a private bucket or sign a URL. A publishable key here satisfies
# every "is it set?" check and then fails on the first customer upload with a
# row-level-security error.
#
# Tell them apart: service-role starts sb_secret_ (or is a long eyJ... JWT);
# publishable starts sb_publishable_ and is safe to expose. If you paste the
# wrong one, GET /api/health reports it by name before any customer sees it.
#
# Server-side only: it bypasses row-level security. Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRIVATE_BUCKET="kapibara-private"
SUPABASE_PUBLIC_BUCKET="kapibara-public"

# ── Option B: S3-compatible (AWS S3, Cloudflare R2, MinIO, Yandex) ────────────
# The private bucket MUST have public access blocked in its bucket policy.
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION="auto"
# S3_PRIVATE_BUCKET="kapibara-private"
# S3_PUBLIC_BUCKET="kapibara-public"
# Required for R2, MinIO and other non-AWS endpoints.
# S3_ENDPOINT="https://ACCOUNT.r2.cloudflarestorage.com"
# Set to "false" only for AWS S3 with virtual-hosted-style addressing.
# S3_FORCE_PATH_STYLE="true"
# CDN origin for public objects, if you serve them through one.
# S3_PUBLIC_BASE_URL="https://cdn.example.com"

# ── Option C: local filesystem — DEVELOPMENT ONLY ─────────────────────────────
# UPLOAD_DIR="./private-uploads"
# PRODUCT_IMAGE_DIR="./public-uploads"


# ───────────────────────────────────────────────────────────────────────────────
# BACKGROUND WORKER — required for AI illustration generation
# ───────────────────────────────────────────────────────────────────────────────

# Shared secret for POST/GET /api/cron/worker. Without it the endpoint refuses
# every request. Generate with:  openssl rand -hex 32
# Only needed when using scheduled cron instead of a long-running worker.
CRON_SECRET=

# Long-running worker only. Seconds between queue polls, and a name that
# identifies this instance in job leases and logs.
# WORKER_INTERVAL_MS="15000"
# WORKER_NAME="worker-1"


# ───────────────────────────────────────────────────────────────────────────────
# OPTIONAL INTEGRATIONS — each degrades honestly when absent
# ───────────────────────────────────────────────────────────────────────────────

# ── Email ─────────────────────────────────────────────────────────────────────
# Without any of these, emails are written to the server log in development and
# refused in production, and the UI says delivery is not configured.
# "resend" | "smtp" | "console". Omit to auto-select whichever is configured.
MAIL_DRIVER="resend"

# Resend — recommended: an HTTP API, so it works on platforms that block SMTP.
# Get a key at resend.com → API Keys, and verify your sending domain first.
RESEND_API_KEY=

# Envelope sender. The domain must be verified with your provider.
MAIL_FROM="Капибара <no-reply@example.com>"
# Where customer replies should go, if different.
# MAIL_REPLY_TO="support@example.com"

# SMTP — alternative to Resend, for a self-hosted or corporate mail server.
# SMTP_HOST=
# SMTP_PORT="587"
# Leave unset to infer: implicit TLS on 465, STARTTLS otherwise.
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=

# ── Online payment (ЮKassa) ───────────────────────────────────────────────────
# Without these the shop takes orders with payment on confirmation and never
# claims money was collected.
# Both values: yookassa.ru → Настройки → Магазин.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional shared secret appended to the notification URL you register with
# ЮKassa. When set, a webhook without a matching x-webhook-secret header is
# rejected before its body is parsed. Generate with: openssl rand -hex 32
YOOKASSA_WEBHOOK_SECRET=

# ── AI illustrations (Nano Banana Pro, via kie.ai) ────────────────────────────
# Without a key the preview says illustrations are prepared manually and the
# rest of the shop works unchanged.
#
# Billed per generated image, so a misconfigured retry loop costs money — the
# queue caps attempts at three for that reason.
NANO_BANANA_API_KEY=

# Override only to pin a different endpoint or model. Changing the model
# changes both the price and the look of the output.
# NANO_BANANA_API_URL="https://api.kie.ai/api/v1"
# NANO_BANANA_MODEL="nano-banana-pro"


# ───────────────────────────────────────────────────────────────────────────────
# NETWORK
# ───────────────────────────────────────────────────────────────────────────────

# How many of YOUR OWN proxies sit in front of the app.
#
# Rate limiting reads the client address from the right-hand end of
# X-Forwarded-For, because the left-hand entries are supplied by the client and
# can be forged. Set this only if you run additional proxies of your own in
# front of the platform (a CDN plus a load balancer, say). Leave unset on
# Vercel, Railway, Render and Cloudflare, whose own header is used instead.
# TRUSTED_PROXY_COUNT="0"


# ───────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY
# ───────────────────────────────────────────────────────────────────────────────

# "debug" | "info" | "warn" | "error". Defaults to info in production.
# LOG_LEVEL="info"
