{
  "name": "kapibara",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/dev/pglite-server.mjs",
    "worker": "tsx scripts/worker.ts",
    "test": "tsx --conditions=react-server --import ./tests/setup.ts --test --test-concurrency=1 tests/*.test.ts",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run check:secrets && npm test"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@prisma/client": "^6.19.3",
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.12.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.22",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^9.0.4",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.2",
    "resend": "^6.18.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.4.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8",
    "eslint-config-next": "15.3.2",
    "postcss": "^8",
    "server-only": "^0.0.1",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.5",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    }
  }
}
