/src/generated/

# private uploads (customer photos must never reach the repo)
/private-uploads/

# admin-uploaded catalogue artwork (kept out of the repo like any upload)
/public-uploads/

# typescript
*.tsbuildinfo

# vercel
.vercel

# local PostgreSQL data (PGlite) — development only
/.pglite/

# agent session scratch space — not part of the project
/.claude/
